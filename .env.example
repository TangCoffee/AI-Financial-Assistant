# 数据库连接（请替换为自己的账号密码和数据库名）
DATABASE_URL=postgresql://你的用户名:你的密码@localhost:5432/你的数据库名

# JWT 认证配置
JWT_SECRET=请替换为一个复杂的随机字符串
JWT_ALGORITHM=HS256
TOKEN_EXPIRES_IN=300m

# DeepSeek API 配置（请替换为自己的 API Key）
DEEPSEEK_API_KEY=sk-请替换为你的真实API密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI 系统提示词
DEEPSEEK_SYSTEM_PROMPT=你是一位个人财务教练。你将基于用户问题和上下文信息比如用户的收入、支出和财务目标，提供专业的财务建议。回答简洁明了，避免使用专业术语。
